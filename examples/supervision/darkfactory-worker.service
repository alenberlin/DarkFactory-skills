[Unit]
Description=DarkFactory Autopilot worker (operator-configured)
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=REPLACE_WITH_NONROOT_OPERATOR
WorkingDirectory=REPLACE_WITH_FACTORY_WORKING_DIRECTORY
ExecStart=REPLACE_WITH_ABSOLUTE_FACTORY_EXECUTABLE --state REPLACE_WITH_PROTECTED_STATE_PATH worker
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=3700
UMask=0077

[Install]
WantedBy=multi-user.target
