<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.darkfactory.worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_WITH_ABSOLUTE_FACTORY_EXECUTABLE</string>
    <string>--state</string><string>REPLACE_WITH_PROTECTED_STATE_PATH</string>
    <string>worker</string>
  </array>
  <key>WorkingDirectory</key><string>REPLACE_WITH_FACTORY_WORKING_DIRECTORY</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>REPLACE_WITH_PRIVATE_WORKER_STDOUT_PATH</string>
  <key>StandardErrorPath</key><string>REPLACE_WITH_PRIVATE_WORKER_STDERR_PATH</string>
</dict>
</plist>
