{
  "name": "darkfactory-dashboard-checks",
  "private": true,
  "version": "0.3.0",
  "scripts": {
    "test:browser": "playwright test",
    "lint": "eslint src/darkfactory/web/app.js",
    "typecheck": "tsc --allowJs --checkJs --noEmit --target ES2022 --lib ES2022,DOM,DOM.Iterable src/darkfactory/web/app.js",
    "format": "prettier --write src/darkfactory/web/*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  }
}
